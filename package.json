{
  "name": "ai-history-timeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --project=root",
    "serve:out": "serve out -l 4173 --no-clipboard",
    "test:py": "python3 -I -m unittest discover -s tests/unit -p \"test_*.py\"",
    "check:links": "python3 -I scripts/check_links.py",
    "build:pages": "BASE_PATH=/ai-history-timeline NEXT_PUBLIC_SITE_URL=${PAGES_SITE_URL:-http://localhost:4180/ai-history-timeline} next build",
    "test:hosts": "pnpm build:pages && playwright test --project=pages && pnpm build && playwright test --project=root tests/e2e/hosts.spec.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.12.1"
}
